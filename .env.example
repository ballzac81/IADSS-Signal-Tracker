# Copy this file to .env and fill in your values
# NEVER commit .env to git

# Webhook authentication — generate with: openssl rand -hex 24
SECRET_TOKEN=

# Telegram notifications (optional) — IADSS tracker messages
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Freqtrade API password (must match user_data/config.json api_server.password)
FREQTRADE_PASS=

# Default trading pair if the webhook body omits "pair"
TRADING_PAIR=SOL/USD

# Position sizing (global defaults)
STAKE_RATIO=0.5      # fraction of free ledger / free balance per buy (0.5 = 50%)
SELL_RATIO=0.5       # fraction of open position sold per sell (0.5 = 50%)
MIN_STAKE=10         # minimum USD stake, skips buy if below this

# Per-pair ratio overrides (optional)
# STAKE_RATIO_HYPE_USD=0.33
# SELL_RATIO_HYPE_USD=0.33

# Self-hosted only (docker-compose.selfhosted.yml)
# Option A: name of your existing Cloudflare Tunnel Docker network
DOCKER_NETWORK=

# Option B: Cloudflare Tunnel token (if using bundled cloudflared)
CLOUDFLARE_TUNNEL_TOKEN=

# Per-pair ledger allocations (optional)
# These only seed a pair the first time it is seen.
# After a ledger row exists, use POST /deposit and POST /withdraw.
# ALLOCATION_SOL_USD=1000
# ALLOCATION_TAO_USD=1000
# ALLOCATION_HYPE_USD=1000

# LEDGER_FILE=/data/ledger.json
