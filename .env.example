# Copy this file to .env and fill in your values
# NEVER commit .env to git

# Webhook authentication — generate with: openssl rand -hex 24
SECRET_TOKEN=

# Telegram notifications (optional)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Freqtrade API password (must match config.json jwt_secret_key area / api_server.password)
FREQTRADE_PASS=

# Default trading pair
TRADING_PAIR=SOL/USD

# Position sizing (global defaults)
STAKE_RATIO=0.5      # fraction of free balance / ledger per buy (0.5 = 50%)
SELL_RATIO=0.5       # fraction of open position sold per sell (0.5 = 50%)
MIN_STAKE=10         # minimum USD stake, skips buy if below this

# Per-pair ratio overrides (optional)
# Uncomment and set to override the global ratios for a specific pair.
# STAKE_RATIO_HYPE_USD=0.33
# SELL_RATIO_HYPE_USD=0.33
# STAKE_RATIO_SOL_USD=0.5
# SELL_RATIO_TAO_USD=0.5

# Self-hosted only (docker-compose.selfhosted.yml)
# Option A: name of your existing Cloudflare Tunnel Docker network
DOCKER_NETWORK=

# Option B: Cloudflare Tunnel token (if using bundled cloudflared)
CLOUDFLARE_TUNNEL_TOKEN=

# Per-pair ledger allocations (optional)
# Give each pair its own isolated bankroll — profits stay separate per pair.
# Omit to use free-balance mode (stakes against total exchange balance).
# ALLOCATION_SOL_USD=1000
# ALLOCATION_TAO_USD=1000
# ALLOCATION_HYPE_USD=1000

# Ledger file location inside the container (default is fine)
# LEDGER_FILE=/data/ledger.json
